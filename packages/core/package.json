{
    "name": "@basket-bot/core",
    "version": "0.0.1",
    "private": true,
    "description": "Shared domain model, Zod schemas, and utilities",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "eslint . --ext ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "pluralize": "^8.0.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^22.10.5",
        "@types/pluralize": "^0.0.33",
        "eslint": "^9.18.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.53.0",
        "vitest": "^2.1.8"
    }
}
